# Free tier: runs for signed-in visitors without their own API key. Leave unset to require BYOK.
# FREE_TIER_API_KEY is a free key from https://console.groq.com/keys
FREE_TIER_PROVIDER=groq
FREE_TIER_API_KEY=
FREE_TIER_MODEL=llama-3.3-70b-versatile
FREE_TIER_DAILY_LIMIT=1
# Optional second free provider, used automatically when the first is out of quota.
FREE_TIER_FALLBACK_PROVIDER=google
FREE_TIER_FALLBACK_API_KEY=
FREE_TIER_FALLBACK_MODEL=gemini-2.5-flash-lite
# Only for the "custom" provider or a non-default endpoint.
FREE_TIER_BASE_URL=

# Optional: shared rate limiting across serverless instances (in-memory when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Eval harness (npm run eval). Keep values out of git; set them in .env or CI secrets.
# Comma list of provider:model to compare side by side.
EVAL_MODELS=
# Judge model as provider:model (blank = no judge).
EVAL_JUDGE_MODEL=
# Requests per minute throttle for free-tier quotas.
EVAL_RPM=5
EVAL_TIMEOUT_MS=
EVAL_GOOGLE_API_KEY=
EVAL_OPENAI_API_KEY=
EVAL_GROQ_API_KEY=
EVAL_OPENROUTER_API_KEY=
# Single-provider shorthand.
EVAL_PROVIDER=
EVAL_API_KEY=
# When the EVAL_* keys are unset the harness falls back to
# FREE_TIER_PROVIDER / FREE_TIER_API_KEY / FREE_TIER_MODEL above.

# Observability (optional). Run traces export as OTLP/HTTP JSON when set; spans hold counts and names only, never user text.
# Langfuse: OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel and OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 pk:sk>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Print a one-line trace per run outside development.
TRACE_CONSOLE=

# Accounts (free Supabase project). When unset, the free tier falls back to a per-IP counter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_... or the legacy service_role key). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
