# Free tier: runs for visitors without their own API key. Leave unset to require BYOK.
FREE_TIER_PROVIDER=google
FREE_TIER_API_KEY=
FREE_TIER_MODEL=gemini-2.0-flash
FREE_TIER_DAILY_LIMIT=15
# Only for the "custom" provider or a non-default endpoint.
FREE_TIER_BASE_URL=

# Optional: shared rate limiting across serverless instances (in-memory when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
